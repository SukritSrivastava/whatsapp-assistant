# Copy this file to .env and fill in your own values. Never commit .env.

# Get this FREE (no credit card needed) from https://aistudio.google.com/apikey
# Sign in with a Google account -> "Create API key" -> copy it here.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your REAL personal WhatsApp number (the one you actually carry).
# This is where the assistant will send drafts for approval, status
# updates, and where it will listen for your "send / edit / skip" commands.
# Format: countrycode+number, digits only, e.g. 919876543210 for a
# +91 98765 43210 Indian number, no "+" and no spaces.
OWNER_NUMBER=919876543210

# Which Gemini model to use for drafting/classifying replies. The default
# is on the free tier.
GEMINI_MODEL=gemini-2.5-flash
